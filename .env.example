# =============================================================================
# Variables de entorno — copia este archivo a `.env` y ajústalo.
# Nunca subas `.env` al repositorio (está en .gitignore).
# =============================================================================

# --- Aplicación ---
APP_NAME=App Backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Servidor HTTP de la API ---
HOST=0.0.0.0
PORT=8000

# --- Base de datos desacoplada (contenedor Postgres) ---
# El esquema lo crea Alembic; aquí solo defines conexión y credenciales.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db

# --- Seguridad (cámbialo en producción) ---
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS: orígenes del frontend (Vite) separados por coma ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
