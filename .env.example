# =============================================================================
# Variables de entorno — copia este archivo a `.env` y ajústalo.
# Nunca subas `.env` al repositorio (está en .gitignore).
# =============================================================================

# --- Aplicación ---
APP_NAME=App Backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Servidor HTTP de la API ---
HOST=0.0.0.0
PORT=8000

# --- Base de datos desacoplada (contenedor Postgres) ---
# El esquema lo crea Alembic; aquí defines las piezas de conexión.
# DATABASE_URL se arma sola en app/core/config.py a partir de estos valores.
# (Opcional) DATABASE_URL=...  → override explícito si alguna vez lo necesitas.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_HOST=localhost
# Si 5432 está ocupado en tu PC, cámbialo (ej. 5433).
# Dentro de Docker el servicio api usa POSTGRES_HOST=db y puerto 5432 interno.
POSTGRES_PORT=5432

# --- Seguridad (cámbialo en producción) ---
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS: orígenes del frontend (Vite) separados por coma ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
